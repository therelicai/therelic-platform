# The Relic Platform — environment variables
#
# Copy to `.env` and fill in the blanks before `docker compose up`.
# Everything here has a sane default in docker-compose.yml; the only
# values you MUST override before production are the secrets at the
# bottom of this file.

# ---------------------------------------------------------------- core
# Connection string Postgres-side. The compose stack sets this for
# you from POSTGRES_* below; you only need to override if running the
# API directly against an external database.
# DATABASE_URL=postgres://relic:relic@localhost:54322/therelic?sslmode=disable

# Compose-only overrides for the bundled Postgres container.
POSTGRES_USER=relic
POSTGRES_PASSWORD=relic
POSTGRES_DB=therelic
POSTGRES_PORT=54322

# Compose-only overrides for the bundled MinIO container.
MINIO_ROOT_USER=relicminio
MINIO_ROOT_PASSWORD=relicminio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Trace storage bucket. The minio-init service creates it on startup.
S3_BUCKET=relic-traces

# API port exposed on the host.
PORT=8080

# Comma-separated CORS allowlist. Defaults cover the bundled app on
# common vite ports. Add your production app origin here.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# ---------------------------------------------------------- production
# These are blank in the dev defaults so the stack works out of the
# box. Set them before exposing the API to anything except localhost.

# JWT (Supabase HS256 by default; switch to your IdP if you have one).
# Generate via the Supabase dashboard or use any 32+ byte random value.
SUPABASE_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
# RELIC_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# RELIC_JWT_AUDIENCE=authenticated

# Pepper used in HMAC-SHA256 of API key plaintext. Generate via
# `openssl rand -hex 32`. Until set, keys are stored with the legacy
# plain SHA-256 algorithm for back-compat.
# RELIC_API_KEY_PEPPER=

# Master secret for HMAC trace-chain verification. Generate via
# `openssl rand -hex 32`. Must match the RELIC_TRACE_KEY used by the
# relic CLI that produced the trace, or verification fails.
# RELIC_TRACE_KEY=

# When set to 1, the API rejects any trace upload that doesn't carry
# an HMAC chain. Keep blank during rollout, flip on once all clients
# are sealing.
# RELIC_REQUIRE_SEALED_TRACES=

# ---------------------------------------------------------- optional

# Enables the governance worker's LLM-based proposal classifier.
# ANTHROPIC_API_KEY=sk-ant-...

# Retention sweeper (background TTL worker, Slice 7).
# RELIC_RETENTION_INTERVAL=15m
# RELIC_RETENTION_BATCH=100
# RELIC_RETENTION_DISABLED=

# Postgres pool tuning (Slice 8).
# RELIC_PG_MAX_CONNS=20
# RELIC_PG_MIN_CONNS=2
# RELIC_PG_MAX_LIFETIME=30m
# RELIC_PG_MAX_IDLE_TIME=5m
