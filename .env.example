DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-jwt-secret

S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=relic-traces
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_REGION=auto

ANTHROPIC_API_KEY=your-anthropic-key

PORT=8080

# Comma-separated list of allowed CORS origins. Unset uses the production
# defaults (app.therelic.dev + localhost:5173,5174). Set when running the
# app on a non-default host, e.g. local dev with the app on 127.0.0.1:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
